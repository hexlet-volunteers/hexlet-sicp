APP_NAME="SICP Local"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=en
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_SQL_QUERIES=false

# Defaults point at the database from docker compose (make compose-start-database).
# For a locally installed PostgreSQL use port 5432 and your own credentials.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=hexlet_sicp
DB_USERNAME=postgres
DB_PASSWORD=
# DB_SCHEMA=public

# A separate database for tests: every run recreates the schema.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=54320
TEST_DB_DATABASE=hexlet_sicp_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Session cookies get the Secure flag when APP_ENV is production.
# Uncomment to pin the flag explicitly.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=smtp.sparkpostmail.com
MAIL_PORT=587
MAIL_USERNAME=SMTP_Injection
MAIL_PASSWORD=null
MAIL_ENCRYPTION=STARTTLS

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_URL_REDIRECT=

SPARKPOST_SECRET=

GOOGLE_TAG_MANAGER_KEY=
YANDEX_METRIKA_ID=

ACTIVITY_LOGGER_ENABLED=true

GITHUB_GIST_TOKEN=
SITEMAP_GIST_ID=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_URL_REDIRECT=

SENTRY_LARAVEL_DSN=
