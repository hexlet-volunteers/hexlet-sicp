{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "allure-testops": {
            "type": "http",
            "url": "https://hexlet.testops.cloud/api/mcp",
            "headers": {
                "Authorization": "api-token ${ALLURE_TESTOPS_TOKEN}"
            }
        }
    }
}